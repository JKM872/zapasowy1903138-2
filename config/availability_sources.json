    "american_football": {
      "default": [
        "sofascore"
      ],
      "leagues": {
        "nfl": [
          "sofascore",
          "espn_nfl",
          "rotowire_nfl"
        ]
      }
    }
  },
  "sources": {
    "rotowire_nba": {
      "fetcher": "rotowire_nba",
      "url": "https://www.rotowire.com/basketball/nba-lineups.php",
      "timeout": 10,
      "provides": [
        "injuries",
        "predicted_lineup",
        "confirmed_lineup"
      ],
      "enabled": true,
      "note": "200 OK, ~400 KB HTML; expected/confirmed starters plus Out/GTD/Ques per team. robots.txt allows the page."
    },
    "rotowire_nhl": {
      "fetcher": "rotowire_nhl",
      "url": "https://www.rotowire.com/hockey/nhl-lineups.php",
      "timeout": 10,
      "provides": [
        "injuries",
        "predicted_lineup",
        "starting_goalie"
      ],
      "enabled": true,
      "note": "200 OK, ~470 KB HTML; goalie (Confirmed/Likely) plus injuries per team."
    },
    "dailyfaceoff_goalies": {
      "fetcher": "dailyfaceoff_goalies",
      "url": "https://www.dailyfaceoff.com/starting-goalies",
