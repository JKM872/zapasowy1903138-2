{
  "_doc": "Availability source registry. sport -> league key (or 'default') -> ordered list of free sources. A league key is matched against the Forebet row's league code/name (case-insensitive, exact). Each source names a fetcher in tools/availability_sources.py (FETCHERS). Adding a source = one entry here + one fetcher function. 'enabled': false entries are documented but never fetched. 'provides' is informational: injuries, suspensions, predicted_lineup, confirmed_lineup, starting_goalie, player_stats, fixtures. Verified 2026-11-19 from a residential IP with plain requests (10 s timeout); SofaScore needs the curl_cffi/relay/Tor path in sofascore_scraper.",
  "sofascore": {
    "fetcher": "sofascore_lineups",
    "timeout": 10,
    "provides": [
      "injuries",
      "suspensions",
      "confirmed_lineup",
      "player_stats",
      "fixtures"
    ],
    "enabled": true,
    "note": "Primary for every team sport. missingPlayers appear 1-24 h before kick-off in football/NBA; hockey/volleyball/handball/lower leagues usually have no missingPlayers and often no player statistics."
  },
  "sports": {
    "football": {
      "default": [
        "sofascore"
      ],
      "leagues": {
        "england|premier league": [
          "sofascore",
          "transfermarkt_gb1"
        ],
        "spain|laliga": [
          "sofascore",
          "transfermarkt_es1"
        ],
        "spain|la liga": [
          "sofascore",
          "transfermarkt_es1"
        ],
        "italy|serie a": [
          "sofascore",
          "transfermarkt_it1"
        ],
        "germany|bundesliga": [
          "sofascore",
          "transfermarkt_l1"
        ],
        "france|ligue 1": [
          "sofascore",
          "transfermarkt_fr1"
        ],
        "poland|ekstraklasa": [
          "sofascore",
          "transfermarkt_pl1"
        ]
      }
    },
    "basketball": {
      "default": [
        "sofascore"
      ],
      "leagues": {
        "nba": [
          "sofascore",
          "espn_nba",
          "rotowire_nba",
          "nba_official_injury_report"
        ],
        "eur": [
          "sofascore",
          "rotowire_euroleague"
        ],
        "euroleague": [
          "sofascore",
          "rotowire_euroleague"
        ],
        "wnba": [
          "sofascore",
          "espn_wnba"
        ]
      }
    },
    "hockey": {
      "default": [
        "sofascore"
      ],
      "leagues": {
        "nhl": [
          "sofascore",
          "espn_nhl",
          "rotowire_nhl",
          "dailyfaceoff_goalies"
        ]
      }
    },
    "handball": {
      "default": [
        "sofascore"
      ],
      "leagues": {}
    },
    "volleyball": {
      "default": [
        "sofascore"
      ],
      "leagues": {}
    },
    "tennis": {
      "default": [
        "sofascore"
      ],
      "leagues": {}
    },
    "baseball": {
      "default": [
        "sofascore"
      ],
      "leagues": {
